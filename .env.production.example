# Copy to .env.production and replace every placeholder. Never commit the real file.
APP_VERSION=pilot-rc1
APP_DOMAIN=school.example.com
ACME_EMAIL=operations@example.com

POSTGRES_DB=almac
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace-with-bootstrap-owner-password
MIGRATION_DATABASE_USER=almac_migration
MIGRATION_DATABASE_PASSWORD=replace-with-migration-owner-password
APP_DATABASE_USER=almac_app
APP_DATABASE_PASSWORD=replace-with-application-password
# All database passwords must be long, unique, URL-safe values because Compose interpolates them into DATABASE_URL.

RESEND_API_KEY=replace-with-resend-api-key
AUTH_EMAIL_FROM=ALMAC School Management <accounts@example.com>

AUTH_INVITATION_TTL_HOURS=48
AUTH_PASSWORD_MIN_LENGTH=15
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_SESSION_ABSOLUTE_HOURS=12
AUTH_SESSION_IDLE_MINUTES=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_ACCOUNT_LOCK_MINUTES=15
AUTH_PASSWORD_RESET_TTL_MINUTES=30

JSON_BODY_LIMIT=1mb
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
