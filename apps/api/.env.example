DATABASE_URL=postgresql://school_admin:replace-with-a-local-password@localhost:5432/school_mgmt
APP_PUBLIC_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RESEND_API_KEY=
AUTH_EMAIL_FROM=ALMAC School Management <accounts@updates.example.com>
AUTH_INVITATION_TTL_HOURS=48
AUTH_PASSWORD_MIN_LENGTH=15
AUTH_PASSWORD_MAX_LENGTH=128
NODE_ENV=development
AUTH_SESSION_ABSOLUTE_HOURS=12
AUTH_SESSION_IDLE_MINUTES=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_ACCOUNT_LOCK_MINUTES=15
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_PASSWORD_RESET_REQUEST_LIMIT=3
AUTH_PASSWORD_RESET_CONFIRM_LIMIT=5
PORT=4000
JSON_BODY_LIMIT=1mb
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DATABASE_SSL=false
LOG_LEVEL=info
APP_VERSION=development
